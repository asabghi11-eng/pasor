# .env.example — تنظیمات سرور حکم
# کپی کن به .env و مقداردهی کن، یا مستقیم export کن.
# هرچی این‌جا export نشه، سرور با مقدار پیش‌فرض امن/سندباکس بالا میاد.

# ---------------------------------------------------------------------------
# پرداخت واقعی (Zarinpal) — تنها بخشی که برای «پول واقعی» حتماً باید ست بشه
# ---------------------------------------------------------------------------
# پیش‌فرض: sandbox.zarinpal.com — پرداخت‌ها همیشه موفق می‌شن، پول واقعی جابه‌جا نمی‌شه.
# برای رفتن روی پرداخت واقعی، این سه‌تا رو ست کن:
HOKM_ZARINPAL_SANDBOX=false
HOKM_ZARINPAL_MERCHANT_ID=your-real-merchant-id-from-zarinpal-dashboard
HOKM_PUBLIC_BASE_URL=https://your-real-domain.com

# ---------------------------------------------------------------------------
# احراز هویت
# ---------------------------------------------------------------------------
# امضای JWT — اگه ست نشه، سرور خودش یه secret تصادفی می‌سازه که با هر ری‌استارت
# عوض می‌شه (یعنی همه لاگین‌ها باطل می‌شن). برای پروداکشن حتماً یه مقدار ثابت بده:
HOKM_JWT_SECRET=

# ورود با گوگل (اختیاری — اگه خالی بمونه، فقط ورود مهمان/ایمیل کار می‌کنه)
GOOGLE_CLIENT_ID=

HOKM_SESSION_TTL_DAYS=90

# ---------------------------------------------------------------------------
# پایگاه‌داده
# ---------------------------------------------------------------------------
# پیش‌فرض: فایل SQLite کنار پروژه (hokm.db). برای پروداکشن با چند instance،
# DATABASE_URL رو به یه Postgres واقعی بده (اگه server.py/hokm_storage.py ازش
# پشتیبانی کنه؛ در غیر این صورت SQLite تنها گزینه‌ست).
HOKM_DB_PATH=
DATABASE_URL=

# ---------------------------------------------------------------------------
# تایمینگ گیم‌پلی (اختیاری — پیش‌فرض‌ها برای بازی معمولی خوبن)
# ---------------------------------------------------------------------------
HOKM_GRACE_SECONDS=20
HOKM_BOT_THINK_SECONDS=1.1
HOKM_TRICK_RESOLVE_DELAY=1.3
HOKM_QUICK_MATCH_BOT_FILL_SECONDS=12
HOKM_AUTOSAVE_SECONDS=20

# ---------------------------------------------------------------------------
# فقط توسعه — حتماً قبل از پروداکشن این رو false کن
# ---------------------------------------------------------------------------
# اگه "1" باشه (پیش‌فرض)، خریدها بدون پرداخت واقعی رایگان انجام می‌شن —
# فقط برای تست محلی. برای پروداکشن حتماً false کن، وگرنه کسی پول نمی‌ده
# و همه‌چی رو مجانی می‌گیره.
HOKM_DEV_FREE_PURCHASES=0
